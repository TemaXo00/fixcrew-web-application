<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Login Notification</title>
    <style>
        h1 {
            font-size: 40px;
            color: #0077B6;
            line-height: 1.5;
            margin-bottom: 15px;
        }
        p {
            font-size: 24px;
            line-height: 1.3;
        }
        button {
            display: inline-block;
            background-color: #2B9AB0;
            text-decoration: none;
            line-height: 1.4;
            padding: 12px 20px;
            box-sizing: border-box;
            text-align: center;
            border: none;
        }
        a {
            text-decoration: none;
            color: white;
            font-weight: 500;
            font-size: 16px;
        }
    </style>
</head>
<body>
<h1>Login Alert</h1>
<p>Your account was just accessed.</p>
<p>Agent: <%= agent %></p>
<button>
    <a href="<%= ui_link %>">Go to Dashboard</a>
</button>
</body>
</html>