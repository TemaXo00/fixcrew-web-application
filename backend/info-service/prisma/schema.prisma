generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id String @id @default(uuid(4))

  name         String @unique
  avg_response Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("regions")
}
