generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id String @id @default(uuid(4))

  name         String @unique
  avg_response Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([name])
  @@map("regions")
}

model Service {
  id String @id @default(uuid(4))

  name        String @unique
  description String

  price          Int @default(0)
  sale_percent   Int @default(0)
  total_discount Int
  avg_time       Int

  category_id String?
  category    Category? @relation(fields: [category_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([name])
  @@map("services")
}

model Category {
  id String @id @default(uuid(4))

  name String

  services Service[]

  parent_id String?
  parent    Category?  @relation("CategoriesAndSub", fields: [parent_id], references: [id])
  sub       Category[] @relation("CategoriesAndSub")

  @@map("categories")
}
