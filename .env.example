# Build Paths
UI_MAIN_PATH=./client/fixcrew-main
UI_ADMIN_PATH=./client/fixcrew-admin
BLOG_SERVICE_PATH=./server/blog-service
FILE_SERVICE_PATH=./server/file-service
GATEWAY_SERVICE_PATH=./server/gateway-service
INFO_SERVICE_PATH=./server/info-service
MAIL_SERVICE_PATH=./server/mail-service
ORDER_SERVICE_PATH=./server/order-service
USER_SERVICE_PATH=./server/user-service
# Minio
MINIO_USER=user
MINIO_PASSWORD=passwd
# Grafana
GF_ADMIN_USER=user
GF_ADMIN_PASSWORD=passwd
# Redis
REDIS_URL="redis://redis:6379"
# RabbitMQ
RABBIT_MQ_USER=user
RABBIT_MQ_PASSWORD=passwd
MAIL_QUEUE=mail-service-queue
ORDER_QUEUE=order-service-queue
INFO_QUEUE=info-service-queue
# Apps
# Connection
APPS_PROTOCOL="http"
APPS_ENTRYPOINT="fixcrew"
# Domains
APPS_ADMIN_DOMAIN="admin.${APPS_ENTRYPOINT}.com"
APPS_MAIN_DOMAIN="${APPS_ENTRYPOINT}.com"
APPS_GATEWAY_DOMAIN="api.${APPS_ENTRYPOINT}.com"
# Configurations
GATEWAY_URL="${APPS_PROTOCOL}://${APPS_GATEWAY_DOMAIN}"
CORS_ALLOWED_ORIGINS="${APPS_PROTOCOL}://${APPS_ADMIN_DOMAIN}, ${APPS_PROTOCOL}://${APPS_MAIN_DOMAIN}"
MAIL_UI_LINK="${APPS_PROTOCOL}://${APPS_ADMIN_DOMAIN}"
COOKIE_DOMAIN="${APPS_ENTRYPOINT}"
MAIL_USER="email@example.com"
MAIL_PASSWORD="123456"
JWT_SECRET=secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Users DB
USER_DB_USER=user
USER_DB_PASSWORD=passwd
USER_DB_NAME=users
USER_DB_URL="postgresql://${USER_DB_USER}:${USER_DB_PASSWORD}@user-db:5432/${USER_DB_NAME}?schema=public"
# Blog DB
BLOG_DB_USER=user
BLOG_DB_PASSWORD=passwd
BLOG_DB_NAME=blog
BLOG_DB_URL="postgresql://${BLOG_DB_USER}:${BLOG_DB_PASSWORD}@blog-db:5432/${BLOG_DB_NAME}?schema=public"
# Info DB
INFO_DB_USER=user
INFO_DB_PASSWORD=passwd
INFO_DB_NAME=info
INFO_DB_URL="postgresql://${INFO_DB_USER}:${INFO_DB_PASSWORD}@info-db:5432/${INFO_DB_NAME}?schema=public"
# Order DB
ORDER_DB_USER=user
ORDER_DB_PASSWORD=passwd
ORDER_DB_NAME=order
ORDER_DB_URL="postgresql://${ORDER_DB_USER}:${ORDER_DB_PASSWORD}@order-db:5432/${ORDER_DB_NAME}?schema=public"
# File DB
FILE_DB_USER=user
FILE_DB_PASSWORD=passwd
FILE_DB_NAME=file
FILE_DB_URL="postgresql://${FILE_DB_USER}:${FILE_DB_PASSWORD}@file-db:5432/${FILE_DB_NAME}?schema=public"