# Build Paths
UI_MAIN_PATH=./ui/fixcrew-main
UI_ADMIN_PATH=./ui/fixcrew-admin
AUTH_SERVICE_PATH=./backend/auth-service
BLOG_SERVICE_PATH=./backend/blog-service
FILE_SERVICE_PATH=./backend/file-service
GATEWAY_SERVICE_PATH=./backend/gateway-service
INFO_SERVICE_PATH=./backend/info-service
MAIL_SERVICE_PATH=./backend/mail-service
ORDER_SERVICE_PATH=./backend/order-service
USER_SERVICE_PATH=./backend/user-service
# Apps ports
UI_MAIN_PORT=5173
UI_ADMIN_PORT=5174
GATEWAY_SERVICE_PORT=3000
MINIO_API_PORT=9100
MINIO_UI_PORT=9101
GF_PORT=9103
PROM_PORT=9104
LOKI_PORT=9105
# Minio
MINIO_USER=user
MINIO_PASSWORD=12345678
# Grafana
GF_ADMIN_USER=user
GF_ADMIN_PASSWORD=12345678910
# Redis
REDIS_URL=redis:6379
# RabbitMQ
RABBIT_MQ_USER=user
RABBIT_MQ_PASSWORD=123456
MAIL_QUEUE=mail-service-queue
ORDER_QUEUE=order-service-queue
# UI
GATEWAY_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:${UI_ADMIN_PORT}, http://localhost:${UI_MAIN_PORT}, http://thinkpad-server.com:${UI_ADMIN_PORT}, http://thinkpad-server.com:${UI_MAIN_PORT}, http://fixcrew.com:${UI_ADMIN_PORT}, http://fixcrew.com:${UI_MAIN_PORT}"
# Users DB
USER_DB_USER=user
USER_DB_PASSWORD=12345678
USER_DB_NAME=users
USER_DB_URL="postgresql://${USER_DB_USER}:${USER_DB_PASSWORD}@user-db:5432/${USER_DB_NAME}?schema=public"
# Blog DB
BLOG_DB_USER=blog
BLOG_DB_PASSWORD=12345678
BLOG_DB_NAME=blog
BLOG_DB_URL="postgresql://${BLOG_DB_USER}:${BLOG_DB_PASSWORD}@blog-db:5432/${BLOG_DB_NAME}?schema=public"
# Info DB
INFO_DB_USER=info
INFO_DB_PASSWORD=12345678
INFO_DB_NAME=info
INFO_DB_URL="postgresql://${INFO_DB_USER}:${INFO_DB_PASSWORD}@info-db:5432/${INFO_DB_NAME}?schema=public"
# Order DB
ORDER_DB_USER=order
ORDER_DB_PASSWORD=12345678
ORDER_DB_NAME=order
ORDER_DB_URL="postgresql://${ORDER_DB_USER}:${ORDER_DB_PASSWORD}@order-db:5432/${ORDER_DB_NAME}?schema=public"
# File DB
FILE_DB_USER=file
FILE_DB_PASSWORD=12345678
FILE_DB_NAME=file
FILE_DB_URL="postgresql://${FILE_DB_USER}:${FILE_DB_PASSWORD}@file-db:5432/${FILE_DB_NAME}?schema=public"
# Mail
MAIL_USER=user
MAIL_PASSWORD=password
MAIL_UI_LINK="link"
# Auth
JWT_SECRET=secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost