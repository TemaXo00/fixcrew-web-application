generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id String @id @default(uuid(4))

  name         String @unique
  avg_response Int

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([name])
  @@map("regions")
}

model Type {
  id String @id @default(uuid(4))

  name String @unique

  categories Category[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("types")
}

model Category {
  id String @id @default(uuid(4))

  name String

  type_id String
  type    Type   @relation(fields: [type_id], references: [id], onDelete: Cascade)

  services Service[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("categories")
}

model Service {
  id String @id @default(uuid(4))

  name        String @unique
  slug        String @unique
  description String @db.Text

  price        Int  @default(0)
  sale_percent Int  @default(0)
  avg_time     Int?

  is_active Boolean @default(true)

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([name])
  @@map("services")
}
